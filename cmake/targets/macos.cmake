message(STATUS "Building native macOS arm64 target")
if (NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "The macOS target requires a 64-bit compiler.")
endif ()
if (FIRMWARE_UPDATE OR FOTA_ENABLE OR PARSEC_TPM_SE_SUPPORT OR FACTORY_MODE OR RFS_GPIO)
    message(FATAL_ERROR "The initial macOS build supports the Windows feature profile. Disable firmware updates, FACTORY_MODE, Parsec and GPIO.")
endif ()
if (NOT MBED_CLOUD_CLIENT_USE_OPENSSL)
    message(FATAL_ERROR "The initial macOS target requires the shared OpenSSL backend.")
endif ()
set(OPENSSL_USE_STATIC_LIBS ON)
set(OS_BRAND Darwin)
set(MBED_CLOUD_CLIENT_DEVICE aarch64)
set(PAL_TARGET_DEVICE aarch64)
set(PAL_USE_PLATFORM_FILESYSTEM 1)
if (NOT DEFINED EDGE_PRIMARY_NETWORK_INTERFACE_ID)
    set(EDGE_PRIMARY_NETWORK_INTERFACE_ID "default")
endif ()
set(INCLUDE_FILE_NAME "${CMAKE_BINARY_DIR}/macos-include-flags.txt")
file(WRITE "${INCLUDE_FILE_NAME}" "")
if (NOT DEFINED PAL_FS_MOUNT_POINT_PRIMARY)
    set(PAL_FS_MOUNT_POINT_PRIMARY "\"./mcc_config\"")
endif ()
if (NOT DEFINED PAL_FS_MOUNT_POINT_SECONDARY)
    set(PAL_FS_MOUNT_POINT_SECONDARY "${PAL_FS_MOUNT_POINT_PRIMARY}")
endif ()
set(PAL_USER_DEFINED_CONFIGURATION "\"${CMAKE_CURRENT_SOURCE_DIR}/config/sotp_fs_macos.h\"")
add_definitions(-DPAL_PLATFORM_DEFINED_CONFIGURATION="${CMAKE_CURRENT_SOURCE_DIR}/config/pal_macos.h")
