if (NOT CMAKE_HOST_APPLE OR NOT CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64)$")
    message(FATAL_ERROR "This target requires a native Apple Silicon macOS host.")
endif ()
set(CMAKE_OSX_ARCHITECTURES arm64 CACHE STRING "Supported macOS architecture")
set(CMAKE_OSX_DEPLOYMENT_TARGET 14.0 CACHE STRING "Minimum supported macOS version")
if (NOT CMAKE_OSX_ARCHITECTURES STREQUAL "arm64" OR CMAKE_OSX_DEPLOYMENT_TARGET VERSION_LESS 14.0)
    message(FATAL_ERROR "The macOS port supports arm64 and macOS 14 or newer.")
endif ()
set(CMAKE_C_STANDARD 11)
set(CMAKE_C_STANDARD_REQUIRED ON)
set(CMAKE_CXX_STANDARD 14)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
